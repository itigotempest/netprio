<Window
    x:Class="NetPrio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetPrio">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Top"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavPrioritiesItem" Content="Приоритеты" Tag="priorities" Icon="Sort" IsSelected="True" />
            <NavigationViewItem x:Name="NavSettingsItem" Content="Канал и правила" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>

        <Grid Padding="24">
            <ScrollViewer x:Name="PrioritiesScroll" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PrioritiesPanel" RowSpacing="16" MinHeight="420">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <InfoBar x:Name="StatusBanner"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational" />
                    <Button x:Name="ToggleShaperBtn" Grid.Column="1"
                            Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center"
                            Click="ToggleShaper_Click" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Наивысший -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TierHighTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ListView x:Name="HighestList" Grid.Row="1" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="6" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="→" Tag="{x:Bind}" Click="MoveFromHighToMed_Click" Padding="6,2"/>
                                            <Button Grid.Column="2" Content="✕" Tag="{x:Bind}" Click="DeleteFromHigh_Click" Padding="6,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="AddHighBtn" Grid.Row="2" HorizontalAlignment="Stretch" Click="AddHighest_Click" />
                        </Grid>
                    </Border>

                    <!-- Средний -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TierMedTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ListView x:Name="MediumList" Grid.Row="1" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="6" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="←" Tag="{x:Bind}" Click="MoveFromMedToHigh_Click" Padding="6,2"/>
                                            <Button Grid.Column="2" Content="→" Tag="{x:Bind}" Click="MoveFromMedToLow_Click" Padding="6,2"/>
                                            <Button Grid.Column="3" Content="✕" Tag="{x:Bind}" Click="DeleteFromMed_Click" Padding="6,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="AddMedBtn" Grid.Row="2" HorizontalAlignment="Stretch" Click="AddMedium_Click" />
                        </Grid>
                    </Border>

                    <!-- Минимальный -->
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TierLowTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ListView x:Name="LowList" Grid.Row="1" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="6" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="←" Tag="{x:Bind}" Click="MoveFromLowToMed_Click" Padding="6,2"/>
                                            <Button Grid.Column="2" Content="✕" Tag="{x:Bind}" Click="DeleteFromLow_Click" Padding="6,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="AddLowBtn" Grid.Row="2" HorizontalAlignment="Stretch" Click="AddLow_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            </ScrollViewer>

            <ScrollViewer x:Name="SettingsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel x:Name="SettingsPanel" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
                <ComboBox x:Name="LanguageBox" Width="260" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem x:Name="LangAutoItem" Tag="auto" />
                    <ComboBoxItem Content="Русский" Tag="ru" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
                <ToggleSwitch x:Name="AutoStartToggle" IsOn="False" Toggled="AutoStartToggle_Toggled" />
                <ToggleSwitch x:Name="CloseToTrayToggle" IsOn="True" />
                <ToggleSwitch x:Name="AutoSpeedToggle" IsOn="True" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox x:Name="DownloadBox" Value="100" Minimum="1" SpinButtonPlacementMode="Inline" Width="180" />
                    <NumberBox x:Name="UploadBox" Value="100" Minimum="1" SpinButtonPlacementMode="Inline" Width="180" />
                    <Button x:Name="MeasureNowBtn" VerticalAlignment="Bottom" Click="MeasureNow_Click" />
                </StackPanel>
                <Slider x:Name="MediumCapSlider" Minimum="10" Maximum="90" Value="50" />
                <Slider x:Name="LowCapSlider" Minimum="5" Maximum="50" Value="10" />
                <ToggleSwitch x:Name="ExcludeVpnToggle" IsOn="True" />
                <ToggleSwitch x:Name="SkipChecksumToggle" IsOn="False" />
                <Button x:Name="SaveSettingsBtn" Style="{ThemeResource AccentButtonStyle}" Click="SaveSettings_Click" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
